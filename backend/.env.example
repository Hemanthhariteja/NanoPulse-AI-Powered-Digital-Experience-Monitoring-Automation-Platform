# ---- Server ----
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed browser origins (the React dashboard).
CORS_ORIGINS=http://localhost:5173

# ---- Database ----
# Local: mongodb://127.0.0.1:27017/nanopulse   Atlas: mongodb+srv://<user>:<pass>@<cluster>/nanopulse
MONGO_URI=mongodb://127.0.0.1:27017/nanopulse
# Used by `npm test` (a separate database that tests wipe).
MONGO_URI_TEST=mongodb://127.0.0.1:27017/nanopulse_test

# ---- Auth ----
# REQUIRED. At least 32 random characters, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ---- Seed accounts (npm run seed) ----
SEED_ADMIN_EMAIL=admin@nanopulse.local
SEED_ADMIN_PASSWORD=
SEED_TECH_EMAIL=tech@nanopulse.local
SEED_TECH_PASSWORD=

# ---- Monitoring / retention ----
TELEMETRY_RETENTION_DAYS=7
REMEDIATION_GRACE_SECONDS=30
SWEEP_INTERVAL_MS=5000
SIMULATOR_INTERVAL_MS=5000

# ---- Rate limiting ----
RATE_LIMIT_PER_MINUTE=600
LOGIN_RATE_LIMIT_PER_15_MIN=20
LOG_LEVEL=info
